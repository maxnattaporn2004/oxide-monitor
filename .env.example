DATABASE_URL=postgresql://oxide:oxide_dev@localhost:55432/oxide_monitor
BOT_SIMULATOR_URL=http://localhost:8788
PORT=3000

# --- ตัวเลือกเพิ่มเติม (มีค่าเริ่มต้นอยู่แล้ว ไม่ต้องตั้งก็ได้) ---
# ถ้าไม่ได้รับ heartbeat เกินกี่ ms ถือว่าบอทหลุด
HEARTBEAT_TIMEOUT_MS=15000
# ความถี่การ poll บอท + ตรวจ timeout + จ่ายงานอัตโนมัติ
POLL_INTERVAL_MS=5000
# ออเดอร์ DELAYED รอกี่ ms ก่อนตัดสินใจ retry (กลับเข้า QUEUED) หรือ FAILED
DELAYED_GRACE_MS=60000
# จ่ายงานให้บอทได้สูงสุดกี่ครั้งต่อออเดอร์ ก่อนปรับเป็น FAILED
MAX_DISPATCH_ATTEMPTS=3
# จำนวนออเดอร์ที่บอท 1 เครื่องรับพร้อมกันได้
BOT_CAPACITY=1
# retry คำสั่งที่ส่งไป Bot Simulator (จำนวนครั้ง / หน่วงเริ่มต้น ms / timeout ต่อครั้ง ms)
COMMAND_RETRIES=3
RETRY_BASE_MS=300
GATEWAY_TIMEOUT_MS=3000
# true = ระบบจ่ายงานให้ออเดอร์ที่อยู่ QUEUED เองอัตโนมัติ
AUTO_DISPATCH=true
